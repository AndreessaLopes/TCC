# Arquivos que ficam no repositorio mas nao entram no pacote da release,
# e portanto nao entram no deposito com DOI. O GitHub monta os pacotes com
# git archive, que respeita a marcacao export-ignore.

.gitattributes  export-ignore
.gitignore      export-ignore
obsoletos/      export-ignore

# Ferramentas de producao do texto da monografia. Editam o LaTeX e
# conferem regras de redacao, de modo que nao sustentam nenhum numero
# publicado nem geram nenhuma tabela ou figura. Permanecem no GitHub,
# onde registram como o documento foi escrito, e ficam fora do pacote
# citavel, que reune o codigo e os dados do experimento.
scripts/08_escrita/     export-ignore
scripts/10_conferencia/ export-ignore
